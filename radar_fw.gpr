with "config/radar_fw_config.gpr";
project Radar_Fw is

   --  Dossiers listes EXPLICITEMENT (par domaine) : ce projet est
   --  l'application PC (simulation + generation du visualiseur HTML).
   --  La partie temps reel (src/tasking, src/demo) appartient a
   --  radar_demo.gpr, qui lui impose le profil Ravenscar.
   for Source_Dirs use
     ("src/app", "src/geometry", "src/core", "src/perception", "config/");
   for Object_Dir use "obj/" & Radar_Fw_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("radar_fw.adb");

   package Compiler is
      for Default_Switches ("Ada") use Radar_Fw_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   --  Niveau 1 pour ces deux unites : CVC5 seul, au niveau par defaut, ne
   --  relie pas certains quantificateurs (les rangs de la fenetre, le
   --  verdict des cibles retenues) ; Z3 les etablit en quelques pas. Reglage
   --  par fichier : les commandes de preuve restent les memes pour tous.
   package Prove is
      for Proof_Switches ("radar_ld2450_stream.adb") use ("--level=1");
      for Proof_Switches ("radar_ld2450_plausibility.adb") use ("--level=1");
      for Proof_Switches ("radar_dwell.adb") use ("--level=1");
   end Prove;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Radar_Fw;
